# Copy to .env and adjust. Every value here has a working default in config.py, so .env is
# optional — it exists for overriding models, ports and tuning without touching code.

# ------------------------------------------------------------------- models
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=ollama
LLM_MODEL=codellama:7b-instruct
LLM_TEMPERATURE=0.1

# Measured on a 6 GB GPU: 2048 -> 15.6 tok/s, 3072 -> 12.0, 4096 -> 9.5 (stops fully
# offloading). Raise only if you have more VRAM.
LLM_NUM_CTX=3072

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# Ollama embedding calls carry ~2.2s fixed overhead each, so batching dominates ingestion
# speed: batch 1 -> 2249 ms/chunk, batch 32 -> 91 ms/chunk.
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------- retrieval
RETRIEVAL_TOP_K_LAWS=8
RETRIEVAL_TOP_K_CASES=5
RETRIEVAL_MIN_SIMILARITY=0.25
RETRIEVAL_ENABLE_KEYWORD=true
RETRIEVAL_ENABLE_GRAPH=true
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_KEYWORD_WEIGHT=0.6

# ------------------------------------------------------------- orchestration
ORCHESTRATOR_MAX_LOOP_ITERATIONS=2

# -------------------------------------------------------------------- system
ENVIRONMENT=dev
LOG_LEVEL=INFO
# 1-5. Gates capabilities so one codebase demonstrates all five exercises.
ACTIVE_PHASE=5
# inprocess | http
SERVICE_TRANSPORT=inprocess
